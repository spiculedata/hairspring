# Copy to .env (git-ignored) and replace every value before running `docker compose up`.
# The placeholders below are not secrets and must not be used as they are.
#
# Tokens must be at least 16 characters. One way to generate each value:
#   openssl rand -hex 24
# (`hairspring token --role admin` creates a token in a local results database; the compose file
# reads its tokens from the variables below instead, so use generated values here.)

# Password for the PostgreSQL container and the server's connection to it.
HAIRSPRING_DB_PASSWORD=change-me-database-password

# Sign-in token for the web UI and API, role admin (can change worker trust).
HAIRSPRING_ADMIN_TOKEN=change-me-admin-token-0000

# Token the worker containers use, role run. Use a different value from the admin token.
HAIRSPRING_WORKER_TOKEN=change-me-worker-token-000
