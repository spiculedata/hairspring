# Copy to .env (git-ignored) and replace every value before running `docker compose up`.
# The placeholders below are not secrets. The token placeholders are shorter than the 16-character
# minimum on purpose, so an unedited copy is refused when the server starts.
#
# Tokens must be at least 16 characters. One way to generate each value:
#   openssl rand -hex 24
# (`hairspring token --role admin` only prints a random token and stores nothing; you can use its output
# as a value below.)

# Password for the PostgreSQL container and the server's connection to it.
HAIRSPRING_DB_PASSWORD=REPLACE-ME-db-password

# Sign-in token for the web UI and API, role admin (can change worker trust).
HAIRSPRING_ADMIN_TOKEN=REPLACE-ME

# Token the worker containers use, role run. Use a different value from the admin token.
HAIRSPRING_WORKER_TOKEN=REPLACE-ME-TOO
