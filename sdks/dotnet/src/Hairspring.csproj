<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Hairspring guest SDK for .NET: a class library for net10.0, base class library only (no packages). The settings
       keep the build reproducible: nothing in the dll depends on the time, the build directory or the commit. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hairspring</AssemblyName>
    <RootNamespace>Hairspring</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- UnixCreateMode is used on Linux and macOS only (the SDK checks the system at run time). -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Reproducibility">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <DebugType>none</DebugType>
    <Version>0.1.0</Version>
    <InformationalVersion>0.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <EnableSourceLink>false</EnableSourceLink>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hairspring.SelfTest" />
  </ItemGroup>

</Project>
