<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SDK's own tests: BCL only, no test framework, no packages. Exits non-zero when a case fails. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Hairspring.SelfTest</AssemblyName>
    <RootNamespace>Hairspring</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <UseAppHost>false</UseAppHost>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hairspring.csproj" />
  </ItemGroup>

</Project>
