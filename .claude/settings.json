{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf .hairspring*)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(gh pr close *)",
      "Bash(gh release *)",
      "Bash(gh workflow run *)",
      "Bash(git tag *)",
      "Bash(git push * --tags*)",
      "Bash(cargo publish *)",
      "Bash(npm publish *)",
      "Bash(docker push *)",
      "Bash(make release*)",
      "Bash(bash scripts/install*)",
      "Bash(sh scripts/install*)",
      "Edit(/.claude/settings.json)",
      "Edit(/.github/workflows/**)",
      "Edit(/AGENTS.md)",
      "Edit(/SECURITY.md)",
      "Edit(/docs/security/SECURITY-AI.md)",
      "Edit(/scripts/hermit.pin)",
      "Edit(/DCO)",
      "Edit(/LICENSE)"
    ],
    "allow": [
      "Bash(cargo fmt *)",
      "Bash(cargo clippy *)",
      "Bash(cargo test *)",
      "Bash(cargo build *)",
      "Bash(cargo check *)",
      "Bash(cargo metadata *)",
      "Bash(make test)",
      "Bash(make lint)",
      "Bash(make fmt)",
      "Bash(make build)",
      "Bash(make test-scripts)",
      "Bash(make ui)",
      "Bash(npm ci)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(node --test *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git blame *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)"
    ]
  }
}
